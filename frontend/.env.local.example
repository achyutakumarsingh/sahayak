# Sahayak frontend configuration.
#
# Copy to frontend/.env.local and fill in. Names only here — never commit real
# values. NEXT_PUBLIC_* variables are inlined into the browser bundle at build
# time, so put nothing secret in them.

# Base URL of the Sahayak backend, with no trailing slash.
# Local development:  http://localhost:8000
# Deployed:           the backend's public origin
# If unset, the browser falls back to same-origin, which works only when the
# API is proxied under the same host.
NEXT_PUBLIC_API_BASE_URL=
