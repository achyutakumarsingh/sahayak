# Claude API key — powers every agent module in Sahayak.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the orchestration layer.
ANTHROPIC_MODEL=claude-sonnet-5

# Prototype storage. Point at Postgres when the round allows.
DATABASE_URL=sqlite:///./sahayak.db

# Deployment environment: development | production
ENVIRONMENT=development

# Optional. Points the Anthropic SDK at a different host — used to exercise the
# streaming path against a local stub without spending tokens. Leave unset in
# normal development.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8900
