# Google Gemini API key — powers agent modules in Sahayak.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Optional: Claude / Anthropic API key (alternative provider)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Prototype storage. Point at Postgres when the round allows.
DATABASE_URL=sqlite:///./sahayak.db

# Deployment environment: development | production
ENVIRONMENT=development

# Mandi prices from data.gov.in (Agmarknet). Defaults to the rate-limited
# sample key published in data.gov.in's own API docs, which every demo shares
# and which returns 429 under any real load. Register a free key at
# https://data.gov.in and put it here.
# DATA_GOV_IN_API_KEY=

# Path to the trained crop-disease classifier. See backend/models/README.md.
# CROP_MODEL_PATH=models/crop_disease.onnx
