# Sahayak backend configuration.
#
# Copy to backend/.env and fill in. Names only here — never commit real values.
# Every variable is optional unless marked REQUIRED; the defaults in
# app/config.py cover local development.

# REQUIRED for any module that calls Claude (all agent chat, listings,
# verdicts, advice). Without it those endpoints return 503 and say so.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model id. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Points the Anthropic SDK at a different host. Used only to exercise the
# streaming path against a local stub. Leave empty in normal use.
ANTHROPIC_BASE_URL=

# data.gov.in key for the Agmarknet mandi price feed. Defaults to the
# rate-limited sample key published in data.gov.in's own docs, which every
# demo shares and which returns 429 under load. Register a free key at
# https://data.gov.in
DATA_GOV_IN_API_KEY=

# Path to the trained crop-disease classifier, relative to backend/.
# Defaults to models/crop_disease.onnx. The matching labels file is derived
# from it (models/crop_disease.labels.json). See backend/models/README.md.
CROP_MODEL_PATH=

# Prototype storage. Defaults to a local SQLite file.
DATABASE_URL=

# development | production
ENVIRONMENT=
