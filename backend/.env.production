# ==========================================
# Sahayak Backend - Production Environment Variables
# ==========================================

# Application
APP_NAME="Sahayak API"
ENVIRONMENT=production
PORT=8000

# Claude / Anthropic API (for all 8 agent modules)
# Replace with your production Anthropic key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=700
ANTHROPIC_EFFORT=low

# data.gov.in Mandi Prices API (Agmarknet)
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Crop Disease ONNX Model Path (included in repository)
CROP_MODEL_PATH=models/crop_disease.onnx

# Storage (SQLite for prototype, or PostgreSQL connection string)
DATABASE_URL=sqlite:///./sahayak.db

# Allowed CORS Origins (set to '*' or comma-separated URLs like 'https://your-frontend.vercel.app,http://localhost:3000')
CORS_ORIGINS=*
